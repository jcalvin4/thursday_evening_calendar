@page "/antiforgery-error"
@inject NavigationManager NavManager

<h1 class="text-danger">Security Validation Failed</h1>

<div class="alert alert-warning">
    <p>Your request could not be processed due to an invalid or missing antiforgery token.</p>
    <p>This usually happens if:</p>
    <ul>
        <li>The page was left open too long</li>
        <li>You submitted a form after logging out</li>
        <li>The browser blocked cookies</li>
    </ul>
</div>

<button class="btn btn-primary" @onclick="Retry">Reload Page</button>
<button class="btn btn-secondary" @onclick="GoHome">Go Home</button>

@code {
    private void Retry()
    {
        NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
    }

    private void GoHome()
    {
        NavManager.NavigateTo("/");
    }
}